diff --git a/crates/task_dedup/src/lib.rs b/crates/task_dedup/src/lib.rs
index 905781898..517bc2664 100644
--- a/crates/task_dedup/src/lib.rs
+++ b/crates/task_dedup/src/lib.rs
@@ -30,3 +30,90 @@ use outbound::postgres::PgTaskVectorDb;
 /// axum state and handler signatures.
 pub type PgTaskDedupService =
     TaskDedupService<DIMS, TextEmbedding3Small, PgTaskVectorDb, CohereReranker>;
+
+/// Melious embedding model. Asked for [`DIMS`] dimensions, the pgvector column width.
+pub const MELIOUS_EMBEDDING_MODEL: &str = "qwen3-embedding-8b";
+/// Melious rerank model, served by a Cohere-compatible `/rerank`.
+pub const MELIOUS_RERANK_MODEL: &str = "qwen3-reranker-4b";
+const MELIOUS_BASE_URL: &str = "https://api.melious.ai/v1";
+
+/// The API that serves task-dedup embeddings and reranking, from
+/// `TASK_DEDUP_PROVIDER`. Unset is [`Self::OpenAi`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TaskDedupProvider {
+    /// OpenAI `text-embedding-3-small` and Cohere rerank (upstream).
+    OpenAi,
+    /// Melious: [`MELIOUS_EMBEDDING_MODEL`] and [`MELIOUS_RERANK_MODEL`], with
+    /// `MELIOUS_API_KEY` and an optional `MELIOUS_BASE_URL`.
+    Melious,
+}
+
+impl TaskDedupProvider {
+    /// Reads `TASK_DEDUP_PROVIDER` (`openai` or `melious`). Any other value is an error.
+    pub fn from_env() -> anyhow::Result<Self> {
+        match std::env::var("TASK_DEDUP_PROVIDER").ok().as_deref() {
+            None | Some("openai") => Ok(Self::OpenAi),
+            Some("melious") => Ok(Self::Melious),
+            Some(other) => {
+                anyhow::bail!("TASK_DEDUP_PROVIDER={other}: want `openai` or `melious`")
+            }
+        }
+    }
+
+    /// The embedder. Only [`Self::OpenAi`] uses `openai_api_key`.
+    pub fn embedder(self, openai_api_key: &str) -> anyhow::Result<TextEmbedding3Small> {
+        match self {
+            Self::OpenAi => {
+                anyhow::ensure!(
+                    !openai_api_key.trim().is_empty(),
+                    "OpenAI API key is required for task dedup embeddings",
+                );
+                Ok(TextEmbedding3Small::new(openai_api_key))
+            }
+            Self::Melious => {
+                let (api_key, base_url) = melious_endpoint()?;
+                Ok(TextEmbedding3Small::openai_compatible(
+                    api_key,
+                    base_url,
+                    MELIOUS_EMBEDDING_MODEL,
+                ))
+            }
+        }
+    }
+
+    /// The reranker. Only [`Self::OpenAi`] uses `cohere_api_key`.
+    pub fn reranker(self, cohere_api_key: &str) -> anyhow::Result<CohereReranker> {
+        match self {
+            Self::OpenAi => {
+                anyhow::ensure!(
+                    !cohere_api_key.trim().is_empty(),
+                    "Cohere API key is required for task dedup reranking",
+                );
+                Ok(CohereReranker::new(cohere_api_key))
+            }
+            Self::Melious => {
+                let (api_key, base_url) = melious_endpoint()?;
+                Ok(CohereReranker::with_endpoint(
+                    api_key,
+                    format!("{base_url}/rerank"),
+                    MELIOUS_RERANK_MODEL,
+                ))
+            }
+        }
+    }
+}
+
+/// `MELIOUS_API_KEY` (required) and the base URL without a trailing slash.
+fn melious_endpoint() -> anyhow::Result<(String, String)> {
+    let api_key = std::env::var("MELIOUS_API_KEY").unwrap_or_default();
+    anyhow::ensure!(
+        !api_key.trim().is_empty(),
+        "TASK_DEDUP_PROVIDER=melious needs MELIOUS_API_KEY",
+    );
+    // Set but empty (`${MELIOUS_BASE_URL:-}` in compose) is unset.
+    let base_url = std::env::var("MELIOUS_BASE_URL")
+        .ok()
+        .filter(|url| !url.trim().is_empty())
+        .unwrap_or_else(|| MELIOUS_BASE_URL.to_owned());
+    Ok((api_key, base_url.trim_end_matches('/').to_owned()))
+}
