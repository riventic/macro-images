 //! CloudFront signing shared by document locations and exports.
 
 use cloudfront_sign::{SignedOptions, get_signed_url};
+use s3_key::document_key_url_path;
 use std::time::{SystemTime, UNIX_EPOCH};
 
+use crate::config::Config;
+use crate::service::s3::S3;
+
+/// Download URL for `key` in the document storage bucket.
+///
+/// CloudFront-signed; in local mode an S3-presigned GET. Upstream returns the
+/// bare distribution URL in local mode, which only an S3 without access checks
+/// (LocalStack) serves.
+pub(crate) async fn document_object_url(
+    s3: &S3,
+    config: &Config,
+    key: &str,
+) -> anyhow::Result<String> {
+    let expiry_seconds = config.document_storage_service_presigned_url_expiry_seconds;
+    if macro_aws_config::is_local_aws() {
+        return s3
+            .get_document_storage_presigned_url(key, expiry_seconds)
+            .await;
+    }
+    let options = get_cloudfront_signed_options(
+        &config.document_storage_service_cloudfront_signer_public_key_id,
+        config
+            .document_storage_service_cloudfront_signer_private_key
+            .as_ref(),
+        expiry_seconds,
+    )?;
+    get_presigned_url(
+        &config.document_storage_service_cloudfront_distribution_url,
+        &document_key_url_path(key),
+        &options,
+    )
+}
