+/// A model the deployment's Melious key serves, discovered at container start.
+struct MeliousModel {
+    /// Routing id, `melious/<wire id>`.
+    id: &'static str,
+    context_window: u64,
+    supports_images: bool,
+}
+
+/// The Melious models in `MELIOUS_MODELS`: one model per line,
+/// `<wire id> <context window> <supports images: 0|1>`. The deployment writes
+/// it from `GET /v1/models?include_meta=true` before the service starts. A
+/// line that does not parse is dropped and logged, never guessed.
+fn melious_models() -> &'static [MeliousModel] {
+    static MODELS: OnceLock<Vec<MeliousModel>> = OnceLock::new();
+    MODELS.get_or_init(|| {
+        let Ok(list) = std::env::var("MELIOUS_MODELS") else {
+            return Vec::new();
+        };
+        list.lines()
+            .map(str::trim)
+            .filter(|line| !line.is_empty())
+            .filter_map(|line| {
+                let mut fields = line.split_whitespace();
+                let parsed = match (fields.next(), fields.next(), fields.next(), fields.next()) {
+                    (Some(wire), Some(window), Some(images), None) => window
+                        .parse::<u64>()
+                        .ok()
+                        .zip(match images {
+                            "1" => Some(true),
+                            "0" => Some(false),
+                            _ => None,
+                        })
+                        .map(|(window, images)| (wire, window, images)),
+                    _ => None,
+                };
+                let Some((wire, context_window, supports_images)) = parsed else {
+                    tracing::error!(line, "MELIOUS_MODELS: line dropped, want `<id> <window> <0|1>`");
+                    return None;
+                };
+                let id: &'static str = Box::leak(format!("melious/{wire}").into_boxed_str());
+                Some(MeliousModel { id, context_window, supports_images })
+            })
+            .collect()
+    })
+}
+
+fn melious_model(id: &str) -> Option<&'static MeliousModel> {
+    melious_models().iter().find(|model| model.id == id)
+}
+
+/// Whether the router registers `model`'s provider in this deployment. The
+/// OpenAI-compatible providers are optional (their key may be unset), so the
+/// picker must not offer an id that would fall back to the default model.
+pub(crate) fn provider_available(model: &str) -> bool {
+    let key = match model.split('/').next() {
+        Some("cerebras") => "CEREBRAS_API_KEY",
+        Some("fireworks") => "FIREWORK_API_KEY",
+        Some("melious") => "MELIOUS_API_KEY",
+        _ => return true,
+    };
+    std::env::var(key).is_ok_and(|value| !value.is_empty())
+}
