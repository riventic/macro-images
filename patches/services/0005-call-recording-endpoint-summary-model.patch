+#[test]
+fn room_composite_egress_names_a_custom_endpoint_path_style() {
+    let config = |endpoint: Option<&str>| EgressS3Config {
+        bucket: "test-bucket".to_owned(),
+        region: "us-east-1".to_owned(),
+        access_key: "test-access-key".to_owned(),
+        secret: "test-secret".to_owned(),
+        endpoint: endpoint.map(str::to_owned),
+    };
+    let upload = |endpoint: Option<&str>| {
+        let request = build_room_composite_egress_request("room-1", &config(endpoint));
+        match request.outputs.into_iter().next() {
+            Some(EgressOutput::File(EncodedFileOutput {
+                output: Some(encoded_file_output::Output::S3(upload)),
+                ..
+            })) => upload,
+            _ => panic!("expected one S3 file output"),
+        }
+    };
+
+    let custom = upload(Some("http://store:8333"));
+    assert_eq!(custom.endpoint, "http://store:8333");
+    assert!(custom.force_path_style);
+
+    let aws = upload(None);
+    assert_eq!(aws.endpoint, "");
+    assert!(!aws.force_path_style);
+}
