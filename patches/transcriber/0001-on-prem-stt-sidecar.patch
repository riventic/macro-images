+def _stream(sidecar, sent):
+    return SimpleNamespace(
+        _sidecar=sidecar,
+        _conn_options=sentinel.options,
+        _event_ch=SimpleNamespace(send_nowait=sent.append),
+    )
+
+
+class UtteranceTimingTest(unittest.TestCase):
+    def test_final_carries_one_word_spanning_the_vad_utterance(self):
+        sidecar = SimpleNamespace(
+            _recognize_impl=AsyncMock(
+                return_value=stt.SpeechEvent(
+                    type=stt.SpeechEventType.FINAL_TRANSCRIPT,
+                    alternatives=[stt.SpeechData(language="de", text="Guten Morgen")],
+                )
+            )
+        )
+        sent: list[stt.SpeechEvent] = []
+        stream = _stream(sidecar, sent)
+        event = SimpleNamespace(
+            timestamp=12.0, silence_duration=0.5, speech_duration=3.0, frames=sentinel.frames
+        )
+
+        asyncio.run(onprem_stt._UtteranceStream._transcribe(stream, event))
+
+        sidecar._recognize_impl.assert_awaited_once_with(
+            sentinel.frames, conn_options=sentinel.options
+        )
+        [final] = sent
+        [word] = final.alternatives[0].words
+        self.assertEqual(final.type, stt.SpeechEventType.FINAL_TRANSCRIPT)
+        self.assertEqual(word, "Guten Morgen")
+        self.assertEqual((word.start_time, word.end_time), (8.5, 11.5))
+
+    def test_refused_utterance_is_skipped_without_closing_the_stream(self):
+        sidecar = SimpleNamespace(
+            _recognize_impl=AsyncMock(
+                side_effect=APIStatusError("refused", status_code=413, body="")
+            )
+        )
+        sent: list[stt.SpeechEvent] = []
+        event = SimpleNamespace(
+            timestamp=12.0, silence_duration=0.5, speech_duration=3.0, frames=sentinel.frames
+        )
+
+        asyncio.run(onprem_stt._UtteranceStream._transcribe(_stream(sidecar, sent), event))
+
+        self.assertEqual(sent, [])
+
+    def test_noise_burst_is_not_sent(self):
+        sidecar = SimpleNamespace(_recognize_impl=AsyncMock())
+        event = SimpleNamespace(
+            timestamp=2.0, silence_duration=0.55, speech_duration=0.1, frames=sentinel.frames
+        )
+
+        asyncio.run(onprem_stt._UtteranceStream._transcribe(_stream(sidecar, []), event))
+
+        sidecar._recognize_impl.assert_not_awaited()
+
+
 if __name__ == "__main__":
     unittest.main()
