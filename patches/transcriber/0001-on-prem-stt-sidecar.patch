@@ -0,0 +1,204 @@
+"""On-prem speech-to-text: VAD-cut utterances sent to a faster-whisper sidecar.
+
+Replaces the LiveKit Cloud `inference.STT` (Deepgram), so call audio never leaves
+the host. Silero VAD cuts each participant's stream into utterances; each
+utterance goes as one WAV to the sidecar's `POST /transcribe`, which answers
+`{text, language, duration_ms, model}` and detects the language itself.
+
+Whisper returns no word timing. Each FINAL therefore carries ONE timed word that
+spans the utterance, with stream-relative offsets taken from the VAD. That is the
+shape `Transcriber.stt_node` reads to place a segment on the call timeline.
+"""
+
+import asyncio
+import logging
+
+import httpx
+from livekit import rtc
+from livekit.agents import (
+    DEFAULT_API_CONNECT_OPTIONS,
+    APIConnectionError,
+    APIConnectOptions,
+    APIError,
+    APIStatusError,
+    APITimeoutError,
+    stt,
+    utils,
+    vad as vad_pkg,
+)
+from livekit.agents.types import NOT_GIVEN, NotGivenOr, TimedString
+
+logger = logging.getLogger("macro-transcriber.onprem-stt")
+
+# The sidecar refuses audio over 60 s (HTTP 413); Silero buffers up to 60 s plus padding.
+MAX_UTTERANCE_SECONDS = 59.0
+# Shorter VAD segments are mostly noise bursts, on which Whisper invents text.
+MIN_SPEECH_SECONDS = 0.25
+
+
+class SpeechSidecarSTT(stt.STT):
+    """Streaming STT from a VAD plus the sidecar's one-shot `POST /transcribe`."""
+
+    def __init__(
+        self,
+        *,
+        base_url: str,
+        vad: vad_pkg.VAD,
+        http_client: httpx.AsyncClient,
+        timeout_seconds: float,
+    ):
+        super().__init__(
+            capabilities=stt.STTCapabilities(streaming=True, interim_results=False)
+        )
+        self._url = f"{base_url.rstrip('/')}/transcribe"
+        self._vad = vad
+        self._http_client = http_client
+        # Seconds of CPU, not of I/O: the sidecar runs one utterance at a time, so an
+        # utterance can wait behind every other speaker in the call.
+        self._timeout_seconds = timeout_seconds
+
+    @property
+    def model(self) -> str:
+        return "faster-whisper"
+
+    @property
+    def provider(self) -> str:
+        return "speech-sidecar"
+
+    async def _recognize_impl(
+        self,
+        buffer: utils.AudioBuffer,
+        *,
+        language: NotGivenOr[str] = NOT_GIVEN,
+        conn_options: APIConnectOptions,
+    ) -> stt.SpeechEvent:
+        frame = utils.merge_frames(buffer)
+        if frame.duration > MAX_UTTERANCE_SECONDS:
+            logger.warning(
+                "utterance of %.1fs cut to %.0fs for the speech sidecar",
+                frame.duration,
+                MAX_UTTERANCE_SECONDS,
+            )
+            keep = int(MAX_UTTERANCE_SECONDS * frame.sample_rate) * frame.num_channels
+            frame = rtc.AudioFrame(
+                data=frame.data[:keep].tobytes(),
+                sample_rate=frame.sample_rate,
+                num_channels=frame.num_channels,
+                samples_per_channel=keep // frame.num_channels,
+            )
+        wav = frame.to_wav_bytes()
+        try:
+            resp = await self._http_client.post(
+                self._url,
+                files={"audio": ("utterance.wav", wav, "audio/wav")},
+                timeout=self._timeout_seconds,
+            )
+        except httpx.TimeoutException as exc:
+            raise APITimeoutError() from exc
+        except httpx.HTTPError as exc:
+            raise APIConnectionError(str(exc)) from exc
+        if resp.is_error:
+            raise APIStatusError(
+                "speech sidecar refused the utterance",
+                status_code=resp.status_code,
+                body=resp.text,
+            )
+        try:
+            body = resp.json()
+            text, language = body["text"], body["language"]
+        except (ValueError, TypeError, KeyError) as exc:
+            raise APIStatusError(
+                "speech sidecar sent no transcript", status_code=resp.status_code, body=resp.text
+            ) from exc
+        if not isinstance(text, str) or not isinstance(language, str):
+            raise APIStatusError(
+                "speech sidecar sent no transcript", status_code=resp.status_code, body=resp.text
+            )
+        return stt.SpeechEvent(
+            type=stt.SpeechEventType.FINAL_TRANSCRIPT,
+            alternatives=[stt.SpeechData(language=language, text=text.strip())],
+        )
+
+    def stream(
+        self,
+        *,
+        language: NotGivenOr[str] = NOT_GIVEN,
+        conn_options: APIConnectOptions = DEFAULT_API_CONNECT_OPTIONS,
+    ) -> stt.RecognizeStream:
+        return _UtteranceStream(self, vad=self._vad, conn_options=conn_options)
+
+
+class _UtteranceStream(stt.RecognizeStream):
+    """`stt.StreamAdapter`'s loop, plus VAD timing on each FINAL.
+
+    A failed utterance is logged and skipped. The stream stays up, so one
+    refused utterance does not end the participant's transcription. That is why
+    `_transcribe` calls `_recognize_impl` and not `STT.recognize`: after its last
+    retry, `recognize` emits an unrecoverable `error`, and AgentSession closes on it.
+    No retry either: the sidecar keeps decoding a timed-out request, so a retry only
+    queues the same audio again behind it.
+    """
+
+    def __init__(self, sidecar: SpeechSidecarSTT, *, vad: vad_pkg.VAD, conn_options: APIConnectOptions):
+        super().__init__(
+            stt=sidecar, conn_options=APIConnectOptions(max_retry=0, timeout=conn_options.timeout)
+        )
+        self._sidecar = sidecar
+        self._vad = vad
+
+    async def _run(self) -> None:
+        vad_stream = self._vad.stream()
+
+        async def _forward_input() -> None:
+            async for frame in self._input_ch:
+                if isinstance(frame, self._FlushSentinel):
+                    vad_stream.flush()
+                    continue
+                vad_stream.push_frame(frame)
+            vad_stream.end_input()
+
+        async def _recognize() -> None:
+            async for event in vad_stream:
+                match event.type:
+                    case vad_pkg.VADEventType.START_OF_SPEECH:
+                        self._event_ch.send_nowait(
+                            stt.SpeechEvent(type=stt.SpeechEventType.START_OF_SPEECH)
+                        )
+                    case vad_pkg.VADEventType.END_OF_SPEECH:
+                        self._event_ch.send_nowait(
+                            stt.SpeechEvent(type=stt.SpeechEventType.END_OF_SPEECH)
+                        )
+                        await self._transcribe(event)
+
+        tasks = [
+            asyncio.create_task(_forward_input(), name="forward_input"),
+            asyncio.create_task(_recognize(), name="recognize"),
+        ]
+        try:
+            await asyncio.gather(*tasks)
+        finally:
+            await utils.aio.cancel_and_wait(*tasks)
+            await vad_stream.aclose()
+
+    async def _transcribe(self, event: vad_pkg.VADEvent) -> None:
+        # END_OF_SPEECH fires after `silence_duration` of silence; the speech ended before it.
+        ended = max(0.0, event.timestamp - event.silence_duration)
+        started = max(0.0, ended - event.speech_duration)
+        if event.speech_duration < MIN_SPEECH_SECONDS:
+            return
+        try:
+            result = await self._sidecar._recognize_impl(
+                event.frames, conn_options=self._conn_options
+            )
+        except APIError:
+            logger.exception("utterance not transcribed, start=%.2fs end=%.2fs", started, ended)
+            return
+        alt = result.alternatives[0] if result.alternatives else None
+        if alt is None or not alt.text:
+            return
+        alt.start_time = started
+        alt.end_time = ended
+        alt.words = [TimedString(alt.text, start_time=started, end_time=ended)]
+        self._event_ch.send_nowait(
+            stt.SpeechEvent(type=stt.SpeechEventType.FINAL_TRANSCRIPT, alternatives=[alt])
+        )
